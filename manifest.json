{
  "$schema": "https://raw.githubusercontent.com/modelcontextprotocol/mcpb/main/dist/mcpb-manifest.schema.json",
  "manifest_version": "0.4",
  "name": "telegram-mcp",
  "display_name": "Telegram",
  "version": "2.0.1",
  "description": "Read, search and send Telegram messages from your own account via Telethon",
  "author": {
    "name": "chigwell"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chigwell/telegram-mcp"
  },
  "homepage": "https://github.com/chigwell/telegram-mcp",
  "documentation": "https://github.com/chigwell/telegram-mcp#readme",
  "support": "https://github.com/chigwell/telegram-mcp/issues",
  "server": {
    "type": "uv",
    "entry_point": "main.py",
    "mcp_config": {
      "command": "uv",
      "args": ["run", "--directory", "${__dirname}", "main.py"],
      "env": {
        "TELEGRAM_API_ID": "${user_config.api_id}",
        "TELEGRAM_API_HASH": "${user_config.api_hash}",
        "TELEGRAM_SESSION_STRING": "${user_config.session_string}",
        "TELEGRAM_ALLOWED_CHAT_IDS": "${user_config.allowed_chat_ids}",
        "TELEGRAM_ALLOWED_ROOTS": "${user_config.allowed_root}"
      }
    }
  },
  "user_config": {
    "api_id": {
      "type": "string",
      "title": "API ID",
      "description": "From https://my.telegram.org/apps",
      "required": true
    },
    "api_hash": {
      "type": "string",
      "title": "API hash",
      "description": "From https://my.telegram.org/apps",
      "required": true,
      "sensitive": true
    },
    "session_string": {
      "type": "string",
      "title": "Session string",
      "description": "Generate it with session_string_generator.py (see the README). Anyone holding it has full access to your account.",
      "required": true,
      "sensitive": true
    },
    "allowed_chat_ids": {
      "type": "string",
      "title": "Allowed chats",
      "description": "Optional comma-separated chat IDs or @usernames. When set, every other chat is hidden from Claude.",
      "required": false,
      "default": ""
    },
    "allowed_root": {
      "type": "directory",
      "title": "Files directory",
      "description": "Optional directory that file tools (send_file, download_media, ...) may read from and write to.",
      "required": false,
      "default": ""
    }
  },
  "compatibility": {
    "platforms": ["darwin", "linux", "win32"],
    "runtimes": {
      "python": ">=3.10"
    }
  },
  "keywords": ["telegram", "telethon", "messaging", "chat"],
  "license": "Apache-2.0"
}
